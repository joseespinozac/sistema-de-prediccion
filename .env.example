# ===================================================================
# Predictor de Tráfico E3 — variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ===================================================================

# --- Servidor Node/Fastify ---
NODE_ENV=development
PORT=3001
# URL base de la app (usada para construir el redirect de OAuth)
APP_BASE_URL=http://localhost:3001

# --- Sesión (cookie httpOnly) ---
# Clave de 32 bytes en hex (64 chars). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CAMBIA_ESTO_por_una_clave_de_32_bytes_en_hex

# --- Encriptación de tokens OAuth en BD (AES-256-GCM) ---
# Clave maestra de 32 bytes en hex (64 chars). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Esta clave NO debe estar en el repo ni en la BD. Si se pierde, los
# tokens encriptados existentes quedan irrecuperables (hay que reconectar).
ENCRYPTION_KEY=CAMBIA_ESTO_por_una_clave_de_32_bytes_en_hex

# --- OAuth2 Google (GA4 + Search Console) ---
# Se generan en Google Cloud Console → APIs y servicios → Credenciales.
# Ver README.md para los pasos completos (habilitar APIs, pantalla de
# consentimiento "Internal", crear ID de cliente OAuth de tipo "Aplicación web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con el URI de redirección autorizado en la consola:
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# --- PageSpeed Insights (salud técnica, sin OAuth) ---
# API key pública de Google Cloud (opcional pero recomendada para cuota).
PAGESPEED_API_KEY=

# --- Servicio de predicción (Python FastAPI + Prophet) ---
PREDICTION_SERVICE_URL=http://127.0.0.1:8000
# Token compartido Node <-> Python. Debe ser IDÉNTICO en ambos servicios.
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_TOKEN=CAMBIA_ESTO_por_un_token_interno_compartido

# --- Parámetros de negocio (con valores por defecto sugeridos, §14) ---
# Mínimo de días de histórico para permitir predicción (cold start).
MIN_HISTORY_DAYS=90
# Umbral de caída significativa (fracción, 0.15 = 15%).
ALERT_DROP_THRESHOLD=0.15
# Horizonte de predicción por defecto (días).
PREDICTION_HORIZON_DAYS=30
# Nivel de confianza por defecto de la banda de predicción.
PREDICTION_CONFIDENCE=0.8

# --- Detector de patrones semanal (reglas, v1 — ver ROADMAP.md) ---
# % de desviación semanal vs. línea base para marcar caída/pico.
PATTERN_DROP_THRESHOLD=0.2
# % de cercanía a la línea base original para considerar "recuperado".
PATTERN_RECOVERY_BAND=0.1
# Nº de semanas anteriores usadas como línea base móvil.
PATTERN_BASELINE_WEEKS=8
# Nº de semanas consecutivas del mismo tipo para llamarlo "tendencia sostenida".
PATTERN_SUSTAINED_WEEKS=3

# --- Reporte periódico (cron, §12 4.5) ---
# Expresión cron para el reporte automático (por defecto: 07:00 a diario).
REPORT_CRON=0 7 * * *
# Poner en "true" para desactivar el cron (útil en tests/desarrollo).
DISABLE_CRON=false
